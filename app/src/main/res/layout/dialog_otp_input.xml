        android:inputType="number"
        android:maxLength="1"
        android:textSize="20sp"
        android:background="@drawable/rounded_textbox"
        android:textColor="#000000"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/etOtp6"
        android:layout_width="42dp"
