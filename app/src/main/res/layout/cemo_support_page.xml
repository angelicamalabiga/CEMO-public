<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    android:fitsSystemWindows="true">

    <!-- ── Top App Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_right"
            android:rotation="180"
            android:contentDescription="@string/support_cd_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/support_title"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#1A2E4A"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="36dp">

            <!-- ════════════════════════════════════ -->
            <!--  SECTION 1 · Help Center / FAQ       -->
            <!-- ════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/support_section_faq"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#5A7A9A"
                android:textSize="11sp" />

            <!-- FAQ Card (white) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:elevation="1dp">

                <!-- FAQ Item 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/faq_q1"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A2E4A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/faq_a1"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#6B7E94"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEF1F5" />

                <!-- FAQ Item 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/faq_q2"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A2E4A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/faq_a2"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#6B7E94"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEF1F5" />

                <!-- FAQ Item 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/faq_q3"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A2E4A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/faq_a3"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#6B7E94"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEF1F5" />

                <!-- FAQ Item 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/faq_q4"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A2E4A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/faq_a4"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#6B7E94"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

            </LinearLayout>

            <!-- ════════════════════════════════════ -->
            <!--  SECTION 2 · Contact Support         -->
            <!-- ════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/support_section_contact"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#5A7A9A"
                android:textSize="11sp" />

            <!-- Contact Card (white) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:elevation="1dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/support_contact_intro"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#6B7E94"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Email tappable row -->
                <LinearLayout
                    android:id="@+id/rowEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/settings_prof_bg"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_contact_label"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#C0D0E0"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_contact_email"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@string/support_cd_open_icon" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/support_contact_note"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#6B7E94"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.5" />

            </LinearLayout>

            <!-- ════════════════════════════════════ -->
            <!--  SECTION 3 · Terms & Disclaimer      -->
            <!-- ════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/support_section_terms"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#5A7A9A"
                android:textSize="11sp" />

            <!-- Terms Card (white) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:elevation="1dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Bullet 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8226;"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A5276"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/support_terms_1"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#6B7E94"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

                <!-- Bullet 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8226;"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A5276"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/support_terms_2"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#6B7E94"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

                <!-- Bullet 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8226;"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A5276"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/support_terms_3"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#6B7E94"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>