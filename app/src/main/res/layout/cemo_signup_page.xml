<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signupLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#243E6D"
    android:fitsSystemWindows="true">

    <!-- Spacer for status bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:background="#243E6D" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/signup_title"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp"
        android:paddingTop="22dp">

        <!-- Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_label_name"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/signup_hint_name"
            android:background="@drawable/rounded_textbox"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="15dp"/>

        <!-- Barangay -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_label_barangay"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <Spinner
            android:id="@+id/spBaranggay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/rounded_textbox"
            android:padding="10dp"
            android:entries="@array/baranggay_list"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="15dp"/>

        <!-- Contact No. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_label_contact"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/etContact"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/signup_hint_contact"
            android:background="@drawable/rounded_textbox"
            android:inputType="phone"
            android:maxLength="11"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="15dp"/>

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_label_email"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/signup_hint_email"
            android:background="@drawable/rounded_textbox"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:inputType="textEmailAddress"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="15dp"/>

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_label_password"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>


        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/signup_hint_password"
            android:background="@drawable/rounded_textbox"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:inputType="textPassword"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="15dp"/>

        <ProgressBar
            android:id="@+id/pbPasswordStrength"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#E0E0E0" />

        <TextView
            android:id="@+id/tvPasswordStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Confirm Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_label_confirm_password"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/signup_hint_confirm_password"
            android:background="@drawable/rounded_textbox"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:inputType="textPassword"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="15dp"/>

        <!-- Register Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_bg"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/signup_btn_register"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"/>

        <!-- Already have account prompt — matches login page style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signup_already_have_account"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signup_login_link"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>