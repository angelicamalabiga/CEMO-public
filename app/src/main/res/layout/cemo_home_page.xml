<?xml version="1.0" encoding="utf-8"?>

<!-- HOME PAGE -->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Full screen w gradient background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_gradient_bg"
        android:orientation="vertical"/>

    <!-- Main content stacked on top -->
    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Part Gradient Color -->
        <LinearLayout
            android:id="@+id/topSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="30dp"
            android:paddingBottom="20dp"
            android:background="@drawable/home_gradient_bg">

            <!-- Top Part Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Profile Icon -->
                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/todo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/prof_icon" />

                <!-- Username + Member ID Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- User Name -->
                    <TextView
                        android:id="@+id/tvUserGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Member ID -->
                    <TextView
                        android:id="@+id/tvMemberId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/member_id_gp_10245"
                        android:textColor="#A09E9E"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Notification Icon + Badge -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/Notification"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/notification" />

                    <TextView
                        android:id="@+id/tvNotifBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/badge_background"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- Environmental Impact Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <!-- White Card Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/your_environmental_impact"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <!-- Total Green Points -->
                    <TextView
                        android:id="@+id/total_points"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/total_green_points_213_pts"
                        android:textColor="#606060"
                        android:textSize="13sp"
                        android:layout_marginBottom="2dp"/>

                    <!-- Points Expiry -->
                    <TextView
                        android:id="@+id/tvPointsExpiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#A09E9E"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone"
                        tools:text="Expires 08.01.25" />


                    <!-- Waste Recycled -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="2dp">

                        <TextView
                            android:id="@+id/tvWasteRecycled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waste Recycled: 0.0kg"
                            android:textColor="#606060"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <!-- Reduced -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">


                        <!--
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reduced_3_3kg"
                            android:textColor="#606060"
                            android:textSize="12sp"/>
                        -->

                    </LinearLayout>

                    <!-- Date and Time Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/last_updated"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wednesday_march_30_2026"
                            android:textColor="#A09E9E"
                            android:textSize="10sp"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:id="@+id/tvLastTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#A09E9E"
                            android:textSize="10sp"
                            tools:ignore="SmallSp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>



            <!-- QR Scan Button -->
            <LinearLayout
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/qr_box_bg">


                    <ImageView
                        android:id="@+id/ivQrIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_qr_scan"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/todo" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/scan_qr_to_recycle"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.05"/>

            </LinearLayout>


        </LinearLayout>

        <!-- White Rounded Card -->
        <FrameLayout
            android:id="@+id/whiteCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/staticContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/home_white_divider"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/recycling_records"
                    android:textColor="#1A1A1A"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/staticRecordsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </androidx.core.widget.NestedScrollView>

                <!-- View Full History — pinned outside scroll, always visible -->
                <TextView
                    android:id="@+id/tvViewFullHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="80dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/full_history"
                    android:textColor="#A09E9E"
                    android:textSize="12sp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <!-- EXPANDED FULL HISTORY VIEW (hidden by default) -->
            <LinearLayout
                android:id="@+id/expandedContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/home_white_divider"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header with title + View Less text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/recycling_records"
                        android:textColor="#1A1A1A"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCollapse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/DOWN"
                        android:textColor="#A09E9E"
                        android:textSize="12sp"
                        android:paddingBottom="5dp"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

                <!-- Scrollable full list -->
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/expandedRecordsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="100dp"/>

                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

            <!-- Floating Nav -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/nav_floating_bg"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Home Tab -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/nav_active_bg"
                    android:layout_margin="6dp">

                    <ImageView
                        android:id="@+id/iconHome"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_home"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:id="@+id/labelHome"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="@string/home"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>

                </LinearLayout>

                <!-- Rewards Tab -->
                <LinearLayout
                    android:id="@+id/navRewards"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/iconRewards"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_rewards"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:id="@+id/labelRewards"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="@string/rewards"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#332d2d"
                        android:textSize="15sp"/>

                </LinearLayout>

                <!-- Settings Tab -->
                <LinearLayout
                    android:id="@+id/navSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/iconSettings"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_settings"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:id="@+id/labelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="@string/settings"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#332d2d"
                        android:textSize="15sp"/>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>