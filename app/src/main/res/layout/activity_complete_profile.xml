<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#243E6D"
    android:fitsSystemWindows="true">

    <!-- Spacer for status bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:background="#243E6D" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Complete Profile"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/poppins_medium"
        android:text="Please fill in your remaining info"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp"
            android:paddingTop="22dp">

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Enter your full name"
                android:background="@drawable/rounded_textbox"
                android:padding="10dp"
                android:textColor="#000000"
                android:textColorHint="#AAAAAA"
                android:inputType="textPersonName"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="15dp"/>

            <!-- Barangay -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <Spinner
                android:id="@+id/spBarangay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/rounded_textbox"
                android:padding="10dp"
                android:entries="@array/baranggay_list"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="15dp"/>

            <!-- Contact No. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Number"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etContact"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Enter your contact number"
                android:background="@drawable/rounded_textbox"
                android:inputType="phone"
                android:maxLength="11"
                android:padding="10dp"
                android:textColor="#000000"
                android:textColorHint="#AAAAAA"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="25dp"/>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Enter your password"
                android:background="@drawable/rounded_textbox"
                android:inputType="textPassword"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:padding="10dp"
                android:textColor="#000000"
                android:textColorHint="#AAAAAA"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="15dp"/>

            <ProgressBar
                android:id="@+id/pbPasswordStrength"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#E0E0E0" />

            <TextView
                android:id="@+id/tvPasswordStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Re-enter your password"
                android:background="@drawable/rounded_textbox"
                android:inputType="textPassword"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:padding="10dp"
                android:textColor="#000000"
                android:textColorHint="#AAAAAA"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="25dp"/>

            <!-- Save Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_bg"
                android:fontFamily="@font/poppins_bold"
                android:text="Save &amp; Continue"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>