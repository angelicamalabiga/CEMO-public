<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffffff"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_left"
            android:padding="6dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Submit Verification"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#1A2E4A"
            android:textSize="17sp"
            android:layout_marginStart="10dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Section: Basic Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basic Information"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#1A2E4A"
                android:textSize="15sp"
                android:layout_marginBottom="14dp" />

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#1A2E4A"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Enter your full name"
                android:fontFamily="@font/poppins_medium"
                android:textSize="13sp"
                android:textColor="#1A2E4A"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/rounded_textbox_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="14dp" />

            <!-- Date of Birth -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date of Birth"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#1A2E4A"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="MM/DD/YYYY"
                android:fontFamily="@font/poppins_medium"
                android:textSize="13sp"
                android:textColor="#1A2E4A"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/rounded_textbox_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="none"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="14dp" />

            <!-- Contact Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Number"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#1A2E4A"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etContact"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. 09XXXXXXXXX"
                android:fontFamily="@font/poppins_medium"
                android:textSize="13sp"
                android:textColor="#1A2E4A"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/rounded_textbox_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="phone"
                android:layout_marginBottom="14dp" />

            <!-- Barangay -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#1A2E4A"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerBarangay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rounded_textbox_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp" />





            <!-- Complete Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete Home Address"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#1A2E4A"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="House No., Street, Barangay, Marikina City"
                android:fontFamily="@font/poppins_medium"
                android:textSize="13sp"
                android:textColor="#1A2E4A"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/rounded_textbox_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:layout_marginBottom="24dp" />

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8E8E8" android:layout_marginBottom="24dp" />

            <!-- Section: ID Upload -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proof of Residency — ID Photo"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#1A2E4A"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload a clear photo of any valid ID showing your Marikina City address."
                android:fontFamily="@font/poppins_medium"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- ID Type Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Type"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#1A2E4A"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerIdType"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rounded_textbox_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp" />

            <!-- ID Photo Upload Area -->
            <LinearLayout
                android:id="@+id/layoutUploadId"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/upload_box_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivIdPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutUploadPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_about"
                        android:contentDescription="Upload" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to upload ID photo"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#1A2E4A"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JPG, PNG · Max 2MB"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change photo"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#1A2E4A"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="24dp" />

            <!-- Consent Checkbox -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginBottom="24dp">

                <CheckBox
                    android:id="@+id/checkConsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="I confirm that all information provided is accurate and that I am a resident of Marikina City. I consent to the processing of my personal data for residency verification purposes."
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#666666"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmitVerification"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Submit for Verification"
                android:fontFamily="@font/poppins_bold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_prof_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Our team will review your submission within 1–3 business days."
                android:fontFamily="@font/poppins_medium"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>