<?xml version="1.0" encoding="utf-8"?>

<!-- REWARDS PAGE — dynamic via RecyclerView -->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Full screen gradient background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_gradient_bg"
        android:orientation="vertical"/>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top White Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:orientation="vertical"
            android:gravity="bottom">

            <!-- Username -->
            <TextView
                android:id="@+id/tvHelloName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text=""
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- Total Points (live from Firestore) -->
            <TextView
                android:id="@+id/tvTotalPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Total Points: 0 pts"
                android:textColor="#1A1A1A"
                android:textSize="15sp"/>

        </LinearLayout>

        <!-- Blue Rounded Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rewards_gradient_bg"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="80dp">

                <!-- AVAILABLE REWARDS title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/available_rewards"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Empty state message -->
                <TextView
                    android:id="@+id/tvNoRewards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="No rewards available yet. Check back soon!"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"/>

                <!-- Dynamic rewards list from Firestore -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRewards"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_reward"/>

            </LinearLayout>

            <!-- Floating Nav Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/nav_floating_bg"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Home Tab -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    tools:ignore="TouchTargetSizeCheck,UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/iconHome"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_home"
                        tools:ignore="ImageContrastCheck"/>

                    <TextView
                        android:id="@+id/labelHome"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/home"
                        android:textColor="#332d2d"
                        android:textSize="15sp"
                        tools:ignore="TextSizeCheck"/>

                </LinearLayout>

                <!-- Rewards Tab (active) -->
                <LinearLayout
                    android:id="@+id/navRewards"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/nav_active_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    tools:ignore="TouchTargetSizeCheck,ExtraText">

                    <ImageView
                        android:id="@+id/iconRewards"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_rewards"
                        tools:ignore="ImageContrastCheck"/>

                    <TextView
                        android:id="@+id/labelRewards"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/rewards"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        tools:ignore="TextSizeCheck"/>

                </LinearLayout>

                <!-- Settings Tab -->
                <LinearLayout
                    android:id="@+id/navSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    tools:ignore="TouchTargetSizeCheck,UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/iconSettings"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_settings"/>

                    <TextView
                        android:id="@+id/labelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/settings"
                        android:textColor="#332d2d"
                        android:textSize="15sp"
                        tools:ignore="TextSizeCheck"/>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>